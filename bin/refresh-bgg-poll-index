#!/usr/bin/env php
<?php
// Fill Search BGG's index: the top-ranked games of each BoardGameGeek
// subdomain with their community polls. Rerun to refresh; polls fetched in
// the last 30 days are kept. Usage: bin/refresh-bgg-poll-index [per-subdomain]

if (PHP_SAPI !== 'cli') {
  exit(1);
}
if ($argc > 2 || ($argc === 2 && !ctype_digit($argv[1]))) {
  fwrite(STDERR, "Usage: bin/refresh-bgg-poll-index [games per subdomain, default 500]\n");
  exit(2);
}

require_once dirname(__DIR__) . '/private/initialize.php';
require_once PRIVATE_PATH . '/bgg_poll_index.php';
ob_end_flush();

$options = $argc === 2 ? ['perSubdomain' => (int) $argv[1]] : [];
$result = bgg_poll_index_refresh($db, $options);
printf(
  "Listed %d games, fetched %d polls, kept %d recent, failed %d.\n",
  $result['listed'],
  $result['fetched'],
  $result['skipped'],
  $result['failed']
);
exit($result['failed'] > 0 ? 1 : 0);
