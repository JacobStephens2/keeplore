RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<IfModule mod_headers.c>    
    # Only these two hosts get an allow-origin, and each origin is a fixed
    # literal. Do not copy the Host into it.
    SetEnvIf Host "^api\.keeplore\.app$" KEEPLORE_UI_ORIGIN=https://keeplore.app
    SetEnvIf Host "^api\.staging\.keeplore\.app$" KEEPLORE_UI_ORIGIN=https://staging.keeplore.app
    Header set Access-Control-Allow-Origin "%{KEEPLORE_UI_ORIGIN}e" env=KEEPLORE_UI_ORIGIN
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE"
    Header set Access-Control-Allow-Headers: Content-Type
    Header set Access-Control-Allow-Credentials: true
    Header set Content-Type "application/json; charset=UTF-8"
</IfModule>